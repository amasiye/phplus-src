{
    "$schema": "https://raw.githubusercontent.com/composer/composer/main/res/composer-schema.json",
    "name": "amasiye/phplus-src",
    "description": "++PHP is a superset of PHP that compiles to clean PHP output.",
    "type": "library",
    "bin": [
        "bin/ppphp"
    ],
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "require": {
        "php": "^8.4",
        "laravel/prompts": "^0.3.24",
        "nikic/php-parser": "^5.6",
        "phpstan/phpstan": "^2.2",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.1"
    },
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Amasiye\\Phplus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
